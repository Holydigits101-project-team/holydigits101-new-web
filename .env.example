# LingoQL Sub0 Project API URL
VITE_API_URL=https://api.your-lingoql-domain.com

# Google ReCAPTCHA Site Key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ─────────────────────────────────────────────────────────────
# The variables below are BACKEND-ONLY.
# Set them in your LingoQL Sub0 project environment settings,
# NOT in this frontend .env file.
# ─────────────────────────────────────────────────────────────

# Scout Portal JWT Auth (used by all protected scout endpoints)
# JWT_SECRET_KEY=your_strong_random_secret_here

# SendGrid Email (used by contact form & scout login)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# SENDGRID_FROM_EMAIL=hello@yourdomain.com
# CONTACT_RECIPIENT_EMAIL=admin@yourdomain.com
# SENDGRID_SCOUT_TEMPLATE_ID=d-your_template_id_here
